# Copy to .env for overrides. Never commit real secrets; in K8s these come from a Secret / Vault.
JWT_SECRET=dev-only-change-me
DEMO_PASSWORD=demo1234
NUM_VEHICLES=100000
EVENTS_PER_SEC=5000
BATCH_INTERVAL_S=60
RATE_LIMIT_PER_MIN=600
# Optional: enables the LLM planner for the copilot (falls back to deterministic planner without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
